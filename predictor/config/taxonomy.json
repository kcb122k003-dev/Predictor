{
  "_comment": "Question-type taxonomy. Add or edit types here, or place a taxonomy.json in your data folder to extend it. 'format' groups types for transition analysis. Patterns are case-insensitive regular expressions matched against the question text.",
  "short_answer_max_marks": 4,
  "long_answer_min_marks": 7,
  "types": [
    {"id": "definition", "label": "Definition", "format": "definition", "weight": 1.0,
     "patterns": ["\\bdefine\\b", "\\bdefinition\\b", "what (?:is|are) (?:meant by|the meaning of)", "what do you (?:mean|understand) by", "^(?:\\W*)what (?:is|are)\\b(?!.*\\b(?:difference|relation|effect|role|significance|importance|principle)\\b)", "\\bmeaning of\\b"]},
    {"id": "derivation", "label": "Derivation", "format": "derivation", "weight": 1.2,
     "patterns": ["\\bderive\\b", "\\bderivation\\b", "\\bobtain (?:an |the )?(?:expression|relation|relationship|equation|formula)", "\\bprove that\\b", "\\bshow that\\b", "\\bdeduce\\b", "\\bdevelop (?:an |the )?(?:expression|equation|relation)", "\\bestablish (?:the |a )?(?:relation|expression|equation)"]},
    {"id": "numerical", "label": "Numerical calculation", "format": "numerical", "weight": 1.0,
     "patterns": ["\\bcalculate\\b", "\\bcompute\\b", "\\bdetermine (?:the )?(?:value|amount|rate|magnitude|number|percentage|efficiency|work|heat|change|pressure|temperature|velocity|discharge|power|force|time|mass|volume|concentration|flow)", "\\bfind (?:the|out)\\b", "\\bestimate\\b", "\\bevaluate\\b", "\\bhow (?:much|many)\\b", "\\bwhat (?:is|will be) the (?:value|final|required|minimum|maximum)"],
     "numeric_cue": true},
    {"id": "problem_solving", "label": "Problem solving", "format": "numerical", "weight": 0.8,
     "patterns": ["\\bsolve\\b", "\\bproblem\\b", "\\bassume suitable\\b", "\\bgiven (?:that|data)\\b"]},
    {"id": "compare_contrast", "label": "Compare / contrast", "format": "theory", "weight": 1.0,
     "patterns": ["\\bcompare\\b", "\\bcomparison\\b", "\\bcontrast\\b", "\\bdifferentiate between\\b", "\\bdistinguish (?:between)?\\b", "\\bdifferences? between\\b", "\\bversus\\b", "\\bvs\\.?\\b"]},
    {"id": "diagram", "label": "Diagram-based", "format": "diagram", "weight": 0.9,
     "patterns": ["\\bsketch\\b", "\\bdraw\\b", "\\bdiagram\\b", "\\bneat (?:sketch|figure|diagram)", "\\bschematic\\b", "\\bplot\\b", "\\bgraph\\b", "\\bflow ?chart\\b", "\\bblock diagram\\b", "\\bfigure\\b"]},
    {"id": "explain_with_example", "label": "Explain with example", "format": "theory", "weight": 0.9,
     "patterns": ["with (?:a |an )?(?:suitable |relevant |appropriate )?examples?", "\\bgive (?:an |some |two |suitable )?examples?\\b", "\\billustrate\\b", "\\bfor example\\b"]},
    {"id": "application", "label": "Application", "format": "theory", "weight": 0.8,
     "patterns": ["\\bapplications? of\\b", "\\bapply\\b", "\\bpractical (?:use|significance|application)", "\\breal[- ]life\\b", "\\bindustrial\\b", "\\bused (?:in|for)\\b"]},
    {"id": "design", "label": "Design problem", "format": "numerical", "weight": 1.0,
     "patterns": ["\\bdesign\\b", "\\bsize the\\b", "\\bselect (?:a |the )?suitable\\b", "\\bspecify\\b"]},
    {"id": "analytical_reasoning", "label": "Analytical reasoning", "format": "theory", "weight": 0.8,
     "patterns": ["\\bwhy\\b", "\\bjustify\\b", "\\banaly[sz]e\\b", "\\bcritically\\b", "\\bcomment on\\b", "\\bgive reasons?\\b", "\\bwhat (?:would|will) happen\\b", "\\binterpret\\b", "\\bexamine\\b"]},
    {"id": "conceptual_explanation", "label": "Conceptual explanation", "format": "theory", "weight": 0.7,
     "patterns": ["\\bexplain\\b", "\\bdescribe\\b", "\\bdiscuss\\b", "\\belaborate\\b", "\\boutline\\b", "\\bwhat (?:is|are) the (?:significance|importance|principle|role|effect)", "\\bwrite (?:about|a note|an essay)"]},
    {"id": "short_answer", "label": "Short answer", "format": "theory", "weight": 0.6,
     "patterns": ["\\bshort notes?\\b", "\\bbriefly\\b", "\\bin brief\\b", "^(?:\\W*)list\\b", "^(?:\\W*)state\\b", "^(?:\\W*)name\\b", "^(?:\\W*)mention\\b", "\\bin (?:one|a) (?:word|sentence|line)"]},
    {"id": "mcq", "label": "MCQ", "format": "objective", "weight": 1.5,
     "patterns": ["\\bchoose the (?:correct|right|best)\\b", "\\bselect the (?:correct|right|best)\\b", "\\bwhich of the following\\b", "\\bmultiple choice\\b", "\\btick (?:the )?(?:correct|right)\\b"]},
    {"id": "true_false", "label": "True / false", "format": "objective", "weight": 1.5,
     "patterns": ["\\btrue or false\\b", "\\bstate whether\\b.*\\b(?:true|false|correct)\\b", "\\bT\\s*/\\s*F\\b"]},
    {"id": "fill_blank", "label": "Fill in the blank", "format": "objective", "weight": 1.5,
     "patterns": ["_{3,}", "\\.{5,}", "\\bfill in the blanks?\\b"]}
  ]
}
